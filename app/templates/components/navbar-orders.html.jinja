{% from 'components/order-status.html.jinja' import order_status %}

{% macro navbar_orders() %}

    <script type="module">
        import { placeOrder, addCocktailQuantity, removeCocktailFromOrder } from "/static/js/order.js";
        
        window.placeOrder = placeOrder;
        window.addCocktailQuantity = addCocktailQuantity;
        window.removeCocktailFromOrder = removeCocktailFromOrder;
    </script>

    <div class="navbar-orders">
        <table class="table-dark"></table>

        <div class="form-row">
            <label for="order-name" class="order-name">
                Nom :
                <input type="text" id="order-name">
            </label>
            <button class="place-order" onclick="window.placeOrder();">Placer la commande</button>
        </div>

        {{ order_status() }}
    </div>

{%- endmacro %}