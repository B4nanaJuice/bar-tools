{% macro navbar(type = "basic") %}

    <div class="navbar">
        <div class="navbar-title">La niche</div>

        <div class="right">
            {% if type == "admin" %}
                <button class="icon-only" onclick="window.location = `{{ url_for('admin.get_orders') }}`;">
                    <svg width="48" height="48" viewBox="0 0 39 27" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M11.5 1.5H37.5M11.5 13.5H37.5M11.5 25.5H37.5M1.5 1.5H1.52M1.5 13.5H1.52M1.5 25.5H1.52" stroke="#FCF9FE" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
                <div></div>
                <button class="icon-only" onclick="window.location = `{{ url_for('admin.manage_stocks') }}`;">
                    <svg width="48" height="48" viewBox="0 0 581 726" fill="none" xmlns="http://www.w3.org/2000/svg" style="transform: rotate(45deg) scale(1.1);">
                        <path d="M448.857 118.291C410.499 89.0375 374.7 56.5759 341.845 21.2572C328.226 7.64623 309.757 0 290.5 0C271.243 0 252.774 7.64623 239.155 21.2572C206.3 56.5759 170.5 89.0375 132.143 118.291C91.546 144.926 58.2127 181.237 35.1452 223.955C12.0776 266.673 0 314.455 0 363C0 411.545 12.0776 459.327 35.1452 502.045C58.2127 544.763 91.546 581.074 132.143 607.709C170.492 636.973 206.291 669.434 239.155 704.743C252.774 718.354 271.243 726 290.5 726C309.757 726 328.226 718.354 341.845 704.743C374.709 669.434 410.508 636.973 448.857 607.709C489.454 581.074 522.787 544.763 545.855 502.045C568.922 459.327 581 411.545 581 363C581 314.455 568.922 266.673 545.855 223.955C522.787 181.237 489.454 144.926 448.857 118.291ZM229.714 252.099C221.543 255.075 153.676 283.354 180.474 390.48C182.814 399.819 181.348 409.705 176.397 417.963C171.446 426.221 163.417 432.174 154.076 434.514C151.192 435.246 148.227 435.612 145.252 435.603C137.163 435.595 129.309 432.887 122.934 427.909C116.56 422.93 112.031 415.967 110.065 408.123C74.8428 267.454 157.671 199.643 206.401 183.344C215.486 180.389 225.37 181.132 233.91 185.412C242.45 189.692 248.959 197.165 252.026 206.21C255.093 215.256 254.471 225.145 250.294 233.734C246.118 242.324 238.723 248.922 229.714 252.099Z" fill="#FCF9FE"/>
                    </svg>
                </button>
            {% elif type == "basic" %}
                <button class="toggle-navbar-for-search icon-only" onclick="document.querySelector('.navbar').classList.toggle('navbar-for-search'); document.querySelector('.navbar').classList.remove('navbar-for-cart');">
                    <svg viewBox="0 0 38 38" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M37 37L28.3 28.3M33 17C33 25.8366 25.8366 33 17 33C8.16344 33 1 25.8366 1 17C1 8.16344 8.16344 1 17 1C25.8366 1 33 8.16344 33 17Z" stroke="#FCF9FE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
                <div></div>
                <button class="toggle-navbar-for-cart icon-only" onclick="document.querySelector('.navbar').classList.toggle('navbar-for-cart'); document.querySelector('.navbar').classList.remove('navbar-for-search');">
                    <svg viewBox="0 0 38 42" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M37 9V37C37 38.0609 36.5786 39.0783 35.8284 39.8284C35.0783 40.5786 34.0609 41 33 41H5C3.93913 41 2.92172 40.5786 2.17157 39.8284C1.42143 39.0783 1 38.0609 1 37V9L7 1H31L37 9ZM1 9H37M27 17C27 19.1217 26.1571 21.1566 24.6569 22.6569C23.1566 24.1571 21.1217 25 19 25C16.8783 25 14.8434 24.1571 13.3431 22.6569C11.8429 21.1566 11 19.1217 11 17" stroke="#FCF9FE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <div class="cart-size"></div>
                </button>
            {% endif %}
        </div>

        {% if type == "basic" %}
            <div class="navbar-search">
                <div class="ingredient-search">
                    <h1 class="search-title">Ingrédients</h1>
                    <div class="list ingredient-list"></div>
                    
                    <select name="ingredient-search-select" id="ingredient-search-select" onchange="addTagToSearch(this, 'ingredient')">
                        <option selected hidden disabled>Choisir...</option>
                        {% for ingredient in ingredients %}
                            <option value="{{ ingredient.id }}">{{ ingredient.name }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="tag-search">
                    <h1 class="search-title">Tags</h1>
                    <div class="list tag-list"></div>

                    <select name="tag-search-select" id="tag-search-select" onchange="addTagToSearch(this, 'tag')">
                        <option selected hidden disabled>Choisir...</option>
                        {% for tag in tags %}
                            <option value="{{ tag.id }}">{{ tag.name }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="name-search">
                    <h1 class="search-title">Nom</h1>
                    <input type="text">
                </div>

                <div class="search-action">
                    <button onclick="startSearch();">
                        Rechercher
                        <svg viewBox="0 0 38 38" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M37 37L28.3 28.3M33 17C33 25.8366 25.8366 33 17 33C8.16344 33 1 25.8366 1 17C1 8.16344 8.16344 1 17 1C25.8366 1 33 8.16344 33 17Z" stroke="#FCF9FE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                </div>

                <script src="{{ url_for('static', filename = 'cocktailSearch.js') }}"></script>
            </div>

            <div class="navbar-cart">
                <table>
                    <tr>
                        <th>Cocktail</th>
                        <th>Quantité</th>
                        <th>Supprimer</th>
                    </tr>
                </table>

                <div class="form-row">
                    <label for="order-name" class="order-name">
                        Nom :
                        <input type="text" id="order-name">
                    </label>
                    <button class="place-order" onclick="placeOrder();">Placer la commande</button>
                </div>

                <script src="{{ url_for('static', filename = 'cocktailOrder.js') }}"></script>
            </div>
        {% endif %}
    </div>

{%- endmacro %}