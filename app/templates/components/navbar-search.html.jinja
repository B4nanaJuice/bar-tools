{% macro navbar_search(ingredients = [], tags = [], ingredient_categories = []) %}

    <div class="navbar-search">
        <div class="ingredient-search">
            <h1 class="search-title">Ingrédients</h1>
            <div class="ingredient-list pill-box white-border"></div>
            
            <select name="ingredient-search-select" id="ingredient-search-select" onchange="window.addTagToSearch('ingredient')">
                <option selected hidden disabled>Choisir...</option>
            </select>
        </div>

        <div class="tag-search">
            <h1 class="search-title">Tags</h1>
            <div class="tag-list pill-box white-border"></div>

            <select name="tag-search-select" id="tag-search-select" onchange="window.addTagToSearch('tag')">
                <option selected hidden disabled>Choisir...</option>
            </select>
        </div>

        <div class="name-search">
            <h1 class="search-title">Nom</h1>
            <input type="text">
        </div>

        <div class="search-action">
            <button onclick="window.startSearch();">
                Rechercher
                <svg viewBox="0 0 38 38" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M37 37L28.3 28.3M33 17C33 25.8366 25.8366 33 17 33C8.16344 33 1 25.8366 1 17C1 8.16344 8.16344 1 17 1C25.8366 1 33 8.16344 33 17Z" stroke="#FCF9FE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
        </div>

        <script type="module" src="{{ url_for('static', filename = 'js/navbar.js') }}"></script>
        <script type="module">
            import { addTagToSearch, startSearch } from './static/js/navbar.js';
            window.addTagToSearch = addTagToSearch;
            window.startSearch = startSearch;
        </script>
    </div>

{%- endmacro %}