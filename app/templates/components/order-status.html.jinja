{% macro order_status() %}

    <div class="order-status"></div>

    <script>
        function followNewOrder(orderId) {
            // Add new order to local storage
            let orders = JSON.parse(localStorage.getItem('orders')) || [];
            orders.push(orderId);
            localStorage.setItem('orders', JSON.stringify(orders));
            // Create new order status bar
            addOrderStatus(orderId);
        }

        function addOrderStatus(orderId) {
            // Add html elements to the navbar
            let div = document.createElement('div');
            div.classList.add(`order-${orderId}`);
            div.innerHTML = `
                <h1 style="font-weight: 300; margin-top: 48px;">Commande n° ${orderId} : <span class="status-${orderId}" style="font-weight: 900;"></span></h1>
                <div class="progress-bar progress-bar-${orderId}" style="width: 100%; margin: auto;">
                    <div class="bar"></div>
                </div>
            `;
            document.querySelector('.order-status').appendChild(div);
            // Refresh the status
            refreshOrderStatus(orderId);
        }

        function refreshOrderStatus(orderId) {
            // Fetch API until status is finished (recursive function)
            (async () => {
                const rawResponse = await fetch(`/api/get-order-status?order-id=${orderId}`, {
                    method: "GET",
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                    }
                });

                const content = await rawResponse.json();                  

                switch (content.status) {
                    case "new":
                        document.querySelector(`.status-${orderId}`).innerText = "En attente";
                        document.querySelector(`.progress-bar-${orderId} .bar`).style.width = "20%";
                        setTimeout(() => { refreshOrderStatus(orderId); }, 1000);
                        break;

                    case "pending":
                        document.querySelector(`.status-${orderId}`).innerText = "En cours";
                        document.querySelector(`.progress-bar-${orderId} .bar`).style.width = "60%";
                        setTimeout(() => { refreshOrderStatus(orderId); }, 1000);
                        break;

                    case "finished":
                        document.querySelector(`.status-${orderId}`).innerText = "Terminée";
                        document.querySelector(`.progress-bar-${orderId} .bar`).style.width = "100%";
                        break;
                }
            })();
        }

        let orders = JSON.parse(localStorage.getItem('orders')) || [];
        for (let orderId of orders) addOrderStatus(orderId);
    </script>

{%- endmacro %}