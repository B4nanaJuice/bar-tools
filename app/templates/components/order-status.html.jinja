{% macro order_status() %}

    <script type="module">
        import { addOrderStatus, removeOrderStatus } from '/static/js/order.js';

        let orders = JSON.parse(localStorage.getItem('orders') || "[]");
        for (let orderId of orders) addOrderStatus(orderId);

        window.removeOrderStatus = removeOrderStatus;
    </script>

    <div class="order-status"></div>

{%- endmacro %}