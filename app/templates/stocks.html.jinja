{% from 'components/navbar.html.jinja' import navbar %}
{% from 'components/footer.html.jinja' import footer %}
{% from 'components/notifications.html.jinja' import notifications %}
{% from 'components/popup.html.jinja' import popup %}

<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="{{ url_for('static', filename = 'base.css') }}">
        <link rel="stylesheet" href="{{ url_for('static', filename = 'navbar.css') }}">
        <link rel="stylesheet" href="{{ url_for('static', filename = 'popup.css') }}">
        <link rel="stylesheet" href="{{ url_for('static', filename = 'notification.css') }}">
        <link rel="stylesheet" href="{{ url_for('static', filename = 'admin.css') }}">
        <title>Gestion des stocks - La niche</title>
    </head>
    <body>

        {{ notifications() }}
        {{ popup() }}
        {{ navbar(type = "admin") }}

        <div class="hero">
            <div class="hero-content">
                <form method="post">
                    {% for ingredient in ingredients %}
                        <div class="input-checkbox">
                            {% if ingredient.is_available %}
                                <input type="checkbox" name="{{ ingredient.id }}" id="{{ ingredient.id }}" value="{{ ingredient.id }}" checked>
                            {% else %}
                                <input type="checkbox" name="{{ ingredient.id }}" id="{{ ingredient.id }}" value="{{ ingredient.id }}">
                            {% endif %}
                            <label for="{{ ingredient.id }}">{{ ingredient.name }}</label>
                        </div>
                    {% endfor %}
                    <div style="width: 100%; margin-top: 32px; display: flex; justify-content: center;">
                        <input type="submit" value="Valider">
                    </div>
                </form>
            </div>
        </div>
        
    </body>
</html>