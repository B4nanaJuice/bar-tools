{% from 'components/navbar.html.jinja' import navbar %}
{% from 'components/footer.html.jinja' import footer %}
{% from 'components/notifications.html.jinja' import notifications %}
{% from 'components/popup.html.jinja' import popup %}

<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="{{ url_for('static', filename = 'base.css') }}">
        <link rel="stylesheet" href="{{ url_for('static', filename = 'navbar.css') }}">
        <link rel="stylesheet" href="{{ url_for('static', filename = 'popup.css') }}">
        <link rel="stylesheet" href="{{ url_for('static', filename = 'notification.css') }}">
        <link rel="stylesheet" href="{{ url_for('static', filename = 'admin.css') }}">
        <link rel="stylesheet" href="{{ url_for('static', filename = 'progress-bar.css') }}">
        <title>Commandes - La niche</title>
    </head>
    <body>

        {{ notifications() }}
        {{ popup() }}
        {{ navbar(type = "admin") }}

        <div class="hero">
            <div class="hero-content">
                <button class="icon-only" onclick="this.parentElement.querySelector('table').classList.toggle('show-finished-orders')">Afficher les commandes terminées</button>
                <table>
                    <tr>
                        <th>
                            <div class="table-row">
                                <p>Statut</p>
                                <p>Nom</p>
                            </div>
                        </th>
                    </tr>
                    {% for order in orders %}
                        <tr class="{{ 'finished-order' if order.status.state == 'finished' else '' }}">
                            <td>
                                <div class="table-column show-order-description can-open-description">
                                    <div class="table-row can-open-description">
                                        <select name="order-status" id="order-status" onchange="updateOrderStatus(this, {{ order.id }})">
                                            {% for state in ["new", "pending", "finished"] %}
                                                <option value="{{state}}" {{ "selected" if order.status.state == state else "" }}>{{ state }}</option>
                                            {% endfor %}
                                        </select>
                                        <p class="can-open-description">{{ order.customer_name }}</p>
                                    </div>
                                    <div class="table-column order-description hidden">
                                        {% for item in order.items %}
                                            <div class="table-row order-item" onclick='showRecipe({{ item.cocktail.id }})'>
                                                <p>{{ item.cocktail.name }}</p>
                                                <p>{{ item.quantity }}</p>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>                            
                            </td>
                        </tr>

                    {% endfor %}
                </table>
            </div>
        </div>

        <script>
            Array.from(document.querySelectorAll('.show-order-description')).map((node) => {
                node.addEventListener('click', function (e) {
                    if (e.target.classList.contains('can-open-description')) {
                        node.querySelector('.order-description').classList.toggle('hidden');
                    }
                });
            });

            function showRecipe(cocktailId) {
                (async () => {
                    const rawResponse = await fetch(`/api/get-cocktail?cocktail-id=${cocktailId}`, {
                        method: "GET",
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/json'
                        }
                    });

                    const content = await rawResponse.json();

                    if (rawResponse.status == 200) {
                        document.querySelector('.popup-title').innerText = content.cocktail.name;
                        document.querySelector('.popup-description').innerHTML = `
                            <ul>
                                ${content.cocktail.ingredients.map(ing => `<li>${ing.quantity} ${ing.unit} ${ing.name}</li>`).join('')}
                            </ul>
                        `;

                        document.querySelector('.popup-content .primary-button').onclick = (e) => {
                            addCocktailToOrder(content.cocktail.name, content.cocktail.id);
                            document.querySelector('.popup').classList.remove('popup-open');
                        }

                        document.querySelector('.popup-content .primary-button p').innerText = "Terminé";

                        document.querySelector('.popup').classList.add('popup-open');
                    } else {
                        createNotification("error", "Woops", "Quelque chose s'est mal passé...");
                    }
                })();
            }

            function updateOrderStatus(selectNode, orderId) {
                (async () => {
                    const rawResponse = await fetch('/api/update-order-status', {
                        method: "POST",
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            "order_id": orderId,
                            "status": selectNode.value
                        })
                    });

                    const content = await rawResponse.json();

                    if (rawResponse.status == 200) {
                        createNotification("success", "Statut changé", content.message);
                        switch (content.status) {
                            case 'new':
                                selectNode.parentElement.parentElement.parentElement.parentElement.classList.remove('finished-order');
                                break;

                            case 'pending':
                                selectNode.parentElement.parentElement.parentElement.parentElement.classList.remove('finished-order');
                                break;

                            case 'finished':
                                selectNode.parentElement.parentElement.parentElement.parentElement.classList.add('finished-order');
                                break;
                        }
                    } else {
                        createNotification("error", "Woops", content.message);
                    }
                })();
            }
        </script>
        
    </body>
</html>